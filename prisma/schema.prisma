datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// USER & WORKSPACE TENANCY
// -------------------------------------------------------------

model User {
  id           String        @id // Clerk User ID (user_...)
  email        String        @unique
  name         String?
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  memberships    OrgMember[]
  subscriptions  Subscription[]
  paymentMethods PaymentMethod[]
  settings       UserSettings?
}

model Organization {
  id        String       @id // Clerk Org ID (org_...)
  name      String
  slug      String       @unique
  imageUrl  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  members       OrgMember[]
  subscriptions Subscription[]
}

enum OrgRole {
  ADMIN
  MEMBER
  VIEWER
}

model OrgMember {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now())

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
}

model UserSettings {
  userId         String   @id
  baseCurrency   String   @default("USD")
  theme          String   @default("system")
  pushEnabled    Boolean  @default(true)
  emailEnabled   Boolean  @default(true)
  reminderOffset Int      @default(3) // Days before renewal to trigger notification
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// SUBSCRIPTION & BILLING
// -------------------------------------------------------------

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String?            // Optional: Set if personal subscription
  orgId           String?            // Optional: Set if team/family subscription
  name            String             // E.g., "Spotify", "AWS", "Electricity"
  plan            String?            // E.g., "Family Plan", "Pro Tier"
  price           Decimal            @db.Decimal(12, 2)
  currency        String             @default("USD")
  billing         BillingPeriod      @default(MONTHLY)
  startDate       DateTime
  renewalDate     DateTime?
  status          SubscriptionStatus @default(ACTIVE)
  color           String?            // Hex color code for UI cards
  icon            String?            // Icon identifier or CDN URL
  notes           String?            // User notes / reference numbers
  paymentMethodId String?
  categoryId      String?
  notificationId  String?            // Push notification trigger ID
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Relations
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments      PaymentHistory[]

  @@index([userId])
  @@index([orgId])
  @@index([status])
  @@index([renewalDate])
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  name      String   // E.g., "HDFC Millennia", "Apple Pay", "UPI - GooglePay"
  type      String   // E.g., "CREDIT_CARD", "DEBIT_CARD", "UPI", "BANK_TRANSFER"
  last4     String?  // E.g., "4321"
  expiry    String?  // E.g., "08/28"
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([userId])
}

model Category {
  id            String         @id @default(cuid())
  name          String         // E.g., "Entertainment", "Utilities", "Software"
  icon          String?        // Icon key
  color         String?        // Hex color
  subscriptions Subscription[]
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

model PaymentHistory {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Decimal       @db.Decimal(12, 2)
  currency       String
  paymentDate    DateTime      @default(now())
  status         PaymentStatus @default(PAID)
  invoiceUrl     String?       // Link to uploaded receipt/invoice PDF
  createdAt      DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([paymentDate])
}